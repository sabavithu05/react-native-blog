  statusText: {
    fontSize: 12,
    fontWeight: "600",
    color: "#111",
  },

  emptyBox: {
    flex: 1,
    justifyContent: "center",
    alignItems: "center",
    gap: 10,
  },

  emptyText: {
    fontSize: 16,
    color: "#888",
  },
});

export default MyTicketsScreen;
